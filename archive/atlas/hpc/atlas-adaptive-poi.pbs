#!/bin/bash
#PBS -q parallel
#PBS -l select=1:ncpus=12:mem=24gb
#PBS -l walltime=240:00:00
#PBS -j oe

set -Eeuo pipefail

: "${WORKFLOW_ID:?WORKFLOW_ID is required}"
: "${SCHEDULER_URL:?SCHEDULER_URL is required}"
: "${SCHEDULER_API_TOKEN_FILE:?SCHEDULER_API_TOKEN_FILE is required}"

BASE=/hpctmp/haoxi.yuan/gmaps_atlas
PROJECT="$BASE/CLI_scraper"
SIF="$BASE/images/playwright-1.57.0-noble.sif"

test -r "$SCHEDULER_API_TOKEN_FILE"
export SINGULARITYENV_SCHEDULER_URL="$SCHEDULER_URL"
export SINGULARITYENV_SCHEDULER_API_TOKEN_FILE="$SCHEDULER_API_TOKEN_FILE"
export SINGULARITYENV_WORKFLOW_ID="$WORKFLOW_ID"
export SINGULARITYENV_WORKERS_PER_JOB="${WORKERS_PER_JOB:-6}"
export SINGULARITYENV_PBS_JOBID="${PBS_JOBID:-manual}"

module load singularity/3.8.3
unset LD_PRELOAD

singularity exec -B /hpctmp:/hpctmp -B /tmp:/tmp -B /home:/home "$SIF" \
  "$PROJECT/scripts/hpc/atlas-adaptive-poi-runner.sh"
