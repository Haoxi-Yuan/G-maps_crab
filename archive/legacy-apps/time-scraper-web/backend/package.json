{
  "name": "gmaps-scraper-backend",
  "version": "1.0.0",
  "description": "Backend API server for Google Maps Batch Scraper",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": ["scraper", "api", "express"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "socket.io": "^4.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "nodemonConfig": {
    "watch": ["server.js", "routes/", "controllers/", "services/", "database.js"],
    "ignore": ["../db/*", "../output/*", "../logs/*", "../data/*", "node_modules/"]
  }
}
