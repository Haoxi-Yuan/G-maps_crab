{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cli-scraper.local/contracts/scraper-monitor-task.schema.json",
  "title": "CLI Scraper live task status",
  "type": "object",
  "required": ["version", "phase", "updatedAt"],
  "properties": {
    "version": { "const": 1 },
    "pipeline": { "type": "string" },
    "taskType": { "type": "string" },
    "city": { "type": ["string", "null"] },
    "phase": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completed": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "unit": { "type": "string" },
    "currentItem": { "type": ["string", "null"] },
    "message": { "type": ["string", "null"] },
    "runtimeSeconds": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
